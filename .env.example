# Gateway Web Co. Copy this file to .env.local for local development.
# Leave the AI keys blank to run the visibility check in sample mode. The results page says so.

# Public URL of this app. Stripe sends people back here after payment.
APP_URL=http://127.0.0.1:43123

# Database. Leave DATABASE_URL empty to use a SQLite file on this machine.
# On a host with an ephemeral disk (Render, for example), set a Postgres URL instead.
# DATABASE_URL=postgres://user:password@host:5432/visibility
# SQLITE_PATH=./data/visibility.db
# PGSSL=require

# OpenAI. The check uses gpt-4o-mini and, by default, the web search tool.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_WEB_SEARCH=false
# OPENAI_SEARCH_TOOL=web_search

# Perplexity Agent API. Sonar chat completions ended in 2026; this app calls /v1/agent.
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=perplexity/sonar

# Gemini, used as a stand-in for Google AI Overviews. Grounding is on unless you turn it off.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_GROUNDING=false

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. When set, new "get it fixed" notes are also saved as an outbox email to this address.
# LEADS_NOTIFY_EMAIL=jalen@example.com

# Protects the monthly re-check route: POST /api/cron/monitor
# Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Free checks per IP per day, and how long a repeat check can reuse the last result.
# RATE_LIMIT_PER_DAY=5
# CACHE_HOURS=24
# MONITOR_INTERVAL_DAYS=30
# RATE_LIMIT_SALT=change-me
