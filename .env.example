# Two Forks Studio. Copy this file to .env.local for local development.
# Leave the AI keys blank to run the visibility check in sample mode. The results page says so.

# Public URL of this app. Stripe sends people back here after payment.
# Leave this as localhost for local dev. On a Render preview, use the preview URL.
# On the live site, set it to https://twoforksstudio.com.
APP_URL=http://127.0.0.1:43123

# Optional. Canonical site URL for metadata, Open Graph, and JSON-LD.
# If unset, APP_URL is used when present (so local dev and Render preview stay
# correct). If both are unset, the default is https://twoforksstudio.com.
# SITE_URL=https://twoforksstudio.com
# NEXT_PUBLIC_SITE_URL=https://twoforksstudio.com

# Database. Leave DATABASE_URL empty to use a SQLite file on this machine.
# On a host with an ephemeral disk (Render, for example), set a Postgres URL instead.
# DATABASE_URL=postgres://user:password@host:5432/visibility
# SQLITE_PATH=./data/visibility.db
# PGSSL=require
# PGSSL values: require (TLS on), no-verify (TLS on, no certificate check for any
# host), disable / off / false / 0 / no (TLS off). Unset: TLS only for *.render.com
# hosts or a URL with sslmode=require.
# With PGSSL=require, Render internal hosts (dpg-xxxx-a) use TLS but skip the
# certificate check automatically, because Render signs them itself. Every other
# host keeps the certificate check. Any sslmode in an internal URL is ignored.
# PGSSL_NO_VERIFY=1 (or true), like PGSSL=no-verify, turns the check off for
# every host. Avoid it unless an external host's certificate cannot be verified.
# PGSSL_NO_VERIFY=1

# Perplexity is the only AI engine. Leave this blank for sample mode.
# The app calls the Agent API at POST /v1/agent with model perplexity/sonar.
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=perplexity/sonar

# Stripe test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional. When set, new "get it fixed" notes are also saved as an outbox email to this address.
# If RESEND_API_KEY and EMAIL_FROM are both set, that note is sent. Otherwise it stays in the outbox.
# LEADS_NOTIFY_EMAIL=jalen@example.com

# Resend (https://resend.com). Both must be set or mail stays in the database only.
# The from-domain has to be verified in Resend. Until twoforksstudio.com is
# verified there, keep using onboarding@resend.dev. Do not default EMAIL_FROM
# to hello@twoforksstudio.com or sending will fail.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Two Forks Studio <onboarding@resend.dev>

# Protects the monthly re-check route: POST /api/cron/monitor
# Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Free checks per IP per day, and how long a repeat check can reuse the last result.
# The daily cap resets at midnight America/Chicago, not UTC.
# RATE_LIMIT_PER_DAY=5
# CACHE_HOURS=24
# MONITOR_INTERVAL_DAYS=30
# Required in production. If this is missing or left as the default, new checks
# are refused so rate-limit hashes stay unpredictable.
# RATE_LIMIT_SALT=change-me

# Client IP for the daily cap. On Render, public requests go through Cloudflare,
# which sets CF-Connecting-IP and rejects a client-supplied value (HTTP 403,
# error 1000). The app trusts that header by default when RENDER=true (Render
# sets this). The right-most X-Forwarded-For hop on Render is a proxy, not the
# visitor, so it is not used for rate limits. X-Forwarded-For is only read for
# local/dev. Only private-network callers (they bypass Cloudflare) can fake
# CF-Connecting-IP. X-Real-IP is never trusted.
# Set TRUST_CF_CONNECTING_IP=false to turn the Render default off.
# On Render, that puts every visitor into one shared daily count.
# TRUST_CF_CONNECTING_IP=true
